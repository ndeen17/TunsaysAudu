# used only by `npm run seed` to create the first logins
SEED_ORGANIZER_USERNAME=organizer
SEED_ORGANIZER_PASSWORD=change-me-now
SEED_SECURITY_USERNAME=security
SEED_SECURITY_PASSWORD=change-me-too
